{
  "title": "Pet Challenge",
  "uid": "pet-challenge",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*pet-challenge.*\"}[1m]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*pet-challenge.*\",outcome=\"SERVER_ERROR\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=~\".*pet-challenge.*\"}[1m])) * 100",
        "legendFormat": "error %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 3,
      "title": "P50 / P99 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\".*pet-challenge.*\"}[1m])) by (le))",
          "legendFormat": "p99"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{job=~\".*pet-challenge.*\"}[1m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(jvm_memory_used_bytes{job=~\".*pet-challenge.*\",area=\"heap\"})",
        "legendFormat": "heap used"
      }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 5,
      "title": "Rate Limiter Rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*pet-challenge.*\",status=\"429\"}[1m]))",
        "legendFormat": "429/s"
      }]
    },
    {
      "id": 6,
      "title": "PetStore Client Cache Hit Ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(cache_gets_total{job=~\".*pet-challenge.*\",result=\"hit\"}[1m])) / sum(rate(cache_gets_total{job=~\".*pet-challenge.*\"}[1m])) * 100",
        "legendFormat": "hit %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    }
  ]
}
